{
  "expo": {
    "name": "uc8-projeto-mobile",
    "slug": "uc8-projeto-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon-quadrado.png",
    "userInterfaceStyle": "light",
    "scheme": "uc8projetomobile",
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exemplo.uc8projetomobile"
    },
    "android": {
      "package": "com.exemplo.uc8projetomobile",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/icon-quadrado.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "e1d2a77f-ed43-4bfc-a8a2-87024c387380"
      }
    }
  }
}
