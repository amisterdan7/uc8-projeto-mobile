# Modo de execução do aplicativo ('equipe' para API v1 com autenticação ou 'curso' para exercício Supabase + SQLite)
EXPO_PUBLIC_MODO=equipe

# URL base da API v1 da Academia MisterFit (usada no modo 'equipe')
# Emulador Android: http://10.0.2.2:3333
# Dispositivo físico / Rede local: http://<IP_DA_MAQUINA>:3333
# Web local: http://localhost:3333
EXPO_PUBLIC_API_URL=http://localhost:3333

# Configuração SOMENTE para o projeto de EXERCÍCIO do curso (dados fictícios de Planos).
# NUNCA informe dados ou URLs do projeto de produção aqui.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_SUA-CHAVE
