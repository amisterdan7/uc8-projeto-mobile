# Modo de execução do aplicativo ('equipe' para API v1 unificada ou 'curso' para exercício Supabase + SQLite)
EXPO_PUBLIC_MODO=equipe

# URL base da API v1 da Academia MisterFit (usada no modo 'equipe')
# celular físico = IP do computador (ex: http://192.168.1.50:3333)
# emulador Android = 10.0.2.2 (ex: http://10.0.2.2:3333)
# produção = HTTPS (ex: https://api.misterfit.com.br)
EXPO_PUBLIC_API_URL=http://IP_DA_MAQUINA:3333

# Variáveis do Supabase do modo curso (comentadas no modo equipe)
# EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_SUA-CHAVE
